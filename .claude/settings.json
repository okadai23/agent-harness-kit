{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.ssh/**)",
      "Read(./.aws/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa)",
      "Read(./**/id_ed25519)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(chmod -R 777 *)",
      "Bash(git push --force *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(yarn publish *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ],
    "allow": [
      "Bash(pnpm verify:fast)",
      "Bash(pnpm verify)",
      "Bash(pnpm docs:verify)",
      "Bash(pnpm harness:diff-scope)",
      "Bash(node scripts/verify-fast.mjs)",
      "Bash(node scripts/verify.mjs)",
      "Bash(node scripts/docs/verify-docs.mjs)",
      "Bash(node scripts/harness/check-diff-scope.mjs)",
      "Bash(node scripts/apm/check-local-package.mjs)",
      "Bash(node scripts/claude/check-native.mjs)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-dispatch.mjs scripts/claude/hooks/prompt_secret_scan.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-dispatch.mjs scripts/claude/hooks/pre_tool_policy.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-dispatch.mjs scripts/claude/hooks/post_tool_policy.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hook-dispatch.mjs scripts/claude/hooks/stop_quality_gate.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}

